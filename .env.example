# TRIPMATE environment variables.
# Copy to .env.local for local development and add the same keys in
# Vercel → Project → Settings → Environment Variables.
#
# Leave both empty to run TRIPMATE in demo mode (data stays in the browser).
#
# Supabase → Project Settings → API:
VITE_SUPABASE_URL=
# The public "anon" key only. Never put the service_role key here or in Git.
VITE_SUPABASE_ANON_KEY=
